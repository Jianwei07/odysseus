# Optional Headroom context-compression sidecar.
#
# Headroom's MCP server speaks stdio only, so we front it with `mcp-proxy`
# (stdio -> SSE) and run `headroom proxy` alongside it for the retrieve cache.
# Odysseus connects to this container over HTTP-MCP (SSE) at /sse; see the
# `headroom` service + profile in docker-compose.yml. Kept separate so the main
# Odysseus image carries none of Headroom's dependencies.
FROM python:3.12-slim

# Pin versions: both CLIs have shifted flags across releases. Bump deliberately.
# [proxy] pulls fastapi/uvicorn for `headroom proxy` (the retrieve cache that
# headroom_retrieve reads from). Without it the proxy aborts and retrieve fails.
RUN pip install --no-cache-dir "headroom-ai[proxy]==0.25.0" "mcp-proxy==0.12.0"

COPY docker/headroom-entrypoint.sh /entrypoint.sh
RUN chmod +x /entrypoint.sh

# SSE endpoint Odysseus connects to (http://headroom:8096/sse).
EXPOSE 8096

ENTRYPOINT ["/entrypoint.sh"]
